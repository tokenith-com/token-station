# 构建期配置模板。实际部署使用随分支提交的 .env.production，
# next build 会自动加载，不需要在命令行传参。
#
# 优先级（Next.js 规则）：.env.production.local > .env.local > .env.production > .env
# 本地临时覆盖（不提交）：cp .env.production .env.production.local 后改地址
#
# 纯静态部署没有 Node 代理，浏览器会直接请求该地址：
# 后端必须放行本站 Origin 的 CORS（见 docs/static-deploy.md）。
NEXT_PUBLIC_TOKENHUB_API_BASE_URL=https://hub.centlt.com

# 门户类型：默认 b（企业端）；设为 c 发布 C 端（含邮箱自助注册与用户协议）。
# NEXT_PUBLIC_TOKENHUB_PORTAL=c